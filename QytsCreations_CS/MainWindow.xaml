<Window x:Class="QytCroRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QytCroRec" Height="780" Width="1280"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource BaseBrush}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- BUTTON STYLES — make Record / Play / Stop POP -->
    <Style x:Key="BtnRecord" TargetType="Button">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#f38ba8"/>
            <GradientStop Offset="1" Color="#c8395f"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderBrush" Value="#ffa3bb"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#f38ba8" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Offset="0" Color="#ff9bb8"/>
                      <GradientStop Offset="1" Color="#d8456f"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPlay" TargetType="Button">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#f9e2af"/>
            <GradientStop Offset="1" Color="#d49832"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="#1e1e2e"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderBrush" Value="#fff2c8"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#f9e2af" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnStop" TargetType="Button">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#4a4a5a"/>
            <GradientStop Offset="1" Color="#2a2a3a"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="#cdd6f4"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderBrush" Value="#6a6a7a"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#cdd6f4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChainPlayButton" TargetType="Button">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#f9e2af"/>
            <GradientStop Offset="1" Color="#fab387"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="#1e1e2e"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.92"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#5a2536"/>
      <Setter Property="Foreground" Value="#f5b3c5"/>
      <Setter Property="BorderBrush" Value="#f38ba8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- Top bar -->
      <RowDefinition Height="*"/>     <!-- Main content -->
      <RowDefinition Height="Auto"/>  <!-- Bottom Chain/Stop bar -->
      <RowDefinition Height="Auto"/>  <!-- Status bar -->
    </Grid.RowDefinitions>

    <!-- ═══ TOP BAR ═══ -->
    <Border Grid.Row="0" Background="{StaticResource CrustBrush}"
            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: group buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="＋ New Group" Width="110" Margin="2,0" Click="BtnAddGroup_Click"/>
          <Button Content="⎘ Duplicate"  Width="100" Margin="2,0" Click="BtnDuplicate_Click"/>
          <Button Content="✕ Delete"     Width="80"  Margin="2,0"
                  Style="{StaticResource DangerButton}" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- Center-left: auto-update controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <CheckBox x:Name="ChkAutoUpdate" Content="Auto-Update" VerticalAlignment="Center"
                    Checked="ChkAutoUpdate_Changed" Unchecked="ChkAutoUpdate_Changed"/>
          <Button Content="Check Now" Margin="8,0,0,0" Click="BtnCheckUpdate_Click"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource BlueBrush}" Padding="6,4"/>
        </StackPanel>

        <!-- Right: log + tray + branding -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="📋 Diag Log"  Width="100" Margin="2,0" Click="BtnDiagLog_Click"/>
          <Button Content="📋 Crash Log" Width="105" Margin="2,0"
                  Style="{StaticResource DangerButton}" Click="BtnCrashLog_Click"/>
          <Button Content="💬 Feedback"  Width="100" Margin="2,0"
                  Background="#1f3a2a" Foreground="#a6e3a1" BorderBrush="#3a5e44"
                  Click="BtnFeedback_Click"/>
          <Button Content="⊟ Tray" Width="70" Margin="2,0" Click="BtnTray_Click"/>
          <TextBlock Text="⬡ QytCroRec" FontSize="14" FontWeight="Bold"
                     Foreground="{StaticResource BlueBrush}"
                     VerticalAlignment="Center" Margin="12,0,4,0"/>
          <TextBlock x:Name="VersionLabel" Text="v1.0.0" FontSize="11"
                     Foreground="{StaticResource Subtext0Brush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ MAIN CONTENT ═══ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="180" MaxWidth="340"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- LEFT PANEL: group list + pixel guard + guard macros -->
      <Grid Grid.Column="0" Background="{StaticResource MantleBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- header -->
          <RowDefinition Height="*"/>     <!-- group list -->
          <RowDefinition Height="Auto"/>  <!-- pixel guard panel -->
          <RowDefinition Height="Auto"/>  <!-- guard macros panel -->
          <RowDefinition Height="Auto"/>  <!-- runs/executions footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface0Brush}" Padding="10,6">
          <TextBlock Text="MACRO GROUPS" FontSize="10" FontWeight="SemiBold"
                     Foreground="{StaticResource Subtext0Brush}"/>
        </Border>

        <ListBox x:Name="GroupList" Grid.Row="1" BorderThickness="0"
                 SelectionChanged="GroupList_SelectionChanged"
                 MouseDoubleClick="GroupList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusTag}" Foreground="{StaticResource GreenBrush}"
                           FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Rename" Click="GroupCtx_Rename"/>
              <MenuItem Header="Duplicate" Click="GroupCtx_Duplicate"/>
              <Separator/>
              <MenuItem Header="Delete" Click="GroupCtx_Delete"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>

        <!-- Pixel Guard (shared) panel -->
        <Border Grid.Row="2" Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0"
                Padding="10,8">
          <StackPanel>
            <TextBlock Text="PIXEL GUARD (shared)" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <TextBlock Text="Source:" Width="60" VerticalAlignment="Center"
                         Foreground="{StaticResource Subtext0Brush}"/>
              <ComboBox x:Name="CmbGuardSource" Width="130"
                        SelectionChanged="CmbGuardSource_Changed">
                <ComboBoxItem Content="Primary"/>
                <ComboBoxItem Content="Secondary"/>
                <ComboBoxItem Content="Third"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="Lanes using it:" FontSize="10" Margin="0,6,0,2"
                       Foreground="{StaticResource Subtext0Brush}"/>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ChkGuardPri" Content="Pri" Margin="0,0,8,0"
                        Checked="ChkGuardUser_Changed" Unchecked="ChkGuardUser_Changed"/>
              <CheckBox x:Name="ChkGuardSec" Content="Sec" Margin="0,0,8,0"
                        Checked="ChkGuardUser_Changed" Unchecked="ChkGuardUser_Changed"/>
              <CheckBox x:Name="ChkGuardThi" Content="Thi"
                        Checked="ChkGuardUser_Changed" Unchecked="ChkGuardUser_Changed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Guard Macros panel -->
        <Border Grid.Row="3" Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0"
                Padding="10,8">
          <StackPanel>
            <TextBlock Text="GUARD MACROS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Content="➕" Width="34" Margin="2,0"
                      Background="#2d8050" Foreground="White" FontWeight="Bold"
                      Click="BtnGuardAdd_Click"/>
              <Button Content="🗑" Width="34" Margin="2,0"
                      Background="#a02828" Foreground="White" FontWeight="Bold"
                      Click="BtnGuardDel_Click"/>
              <Button Content="REC" Width="48" Margin="2,0"
                      Background="#d49832" Foreground="White" FontWeight="Bold"
                      Click="BtnGuardRec_Click"/>
              <Button Content="STOP" Width="52" Margin="2,0"
                      Background="#d44a00" Foreground="White" FontWeight="Bold"
                      Click="BtnGuardStop_Click"/>
            </StackPanel>
            <ListBox x:Name="GuardMacroList" Height="80" BorderThickness="1"
                     BorderBrush="{StaticResource Surface0Brush}"/>
            <Button Content="📋 View Recorded Events" Margin="0,6,0,0"
                    Click="BtnGuardView_Click"/>
          </StackPanel>
        </Border>

        <!-- Runs/Executions footer -->
        <Border Grid.Row="4" Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0"
                Padding="10,6">
          <StackPanel>
            <TextBlock x:Name="RunsLabel" Text="Runs: 0" FontSize="11"
                       Foreground="{StaticResource Subtext0Brush}"
                       Cursor="Hand" MouseRightButtonUp="RunsLabel_RightClick"/>
            <TextBlock x:Name="ExecLabel" Text="Executions: 0" FontSize="11"
                       Foreground="{StaticResource Subtext0Brush}"
                       Cursor="Hand" MouseRightButtonUp="ExecLabel_RightClick"/>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource Surface0Brush}"/>

      <!-- RIGHT PANEL: lane editor + activity log -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>     <!-- tabs + lane sub-content -->
          <RowDefinition Height="140" MinHeight="80"/>  <!-- activity log -->
        </Grid.RowDefinitions>

        <!-- LANE TABS: Primary / Secondary / Third / Shortcuts -->
        <TabControl x:Name="LaneTabs" Grid.Row="0" SelectionChanged="LaneTabs_SelectionChanged">

          <TabItem Header="⭐ Primary">
            <ContentControl x:Name="LaneViewPrimary"/>
          </TabItem>
          <TabItem Header="＋ Secondary">
            <ContentControl x:Name="LaneViewSecondary"/>
          </TabItem>
          <TabItem Header="＋ Third">
            <ContentControl x:Name="LaneViewThird"/>
          </TabItem>
          <TabItem Header="⚙ Shortcuts">
            <ContentControl x:Name="ShortcutsView"/>
          </TabItem>
        </TabControl>

        <!-- Activity log -->
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource CrustBrush}"
                  BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
              <TextBlock Text="ACTIVITY LOG" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
              <Button Content="Clear" HorizontalAlignment="Right" Padding="8,2"
                      Click="BtnClearLog_Click"/>
            </Grid>
          </Border>
          <ListBox x:Name="ActivityLog" Grid.Row="1"
                   Background="{StaticResource CrustBrush}" BorderThickness="0"
                   FontFamily="Consolas" FontSize="11"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"/>
        </Grid>
      </Grid>
    </Grid>

    <!-- ═══ BOTTOM BAR: Play Chain / Stop All ═══ -->
    <Border Grid.Row="2" Background="{StaticResource MantleBrush}"
            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,1"
            Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnPlayChain" Content="▶▶  Play Chain"
                Style="{StaticResource ChainPlayButton}"
                MinWidth="180" Click="BtnPlayChain_Click"/>
        <Button x:Name="BtnStopAll" Content="■  Stop All" Margin="10,0,0,0"
                Style="{StaticResource BtnStop}"
                MinWidth="140" Click="BtnStopAll_Click"/>
        <TextBlock x:Name="RunsInline" Text="  Runs: (none yet)"
                   VerticalAlignment="Center" Margin="20,0,0,0"
                   Foreground="{StaticResource Subtext0Brush}"
                   Cursor="Hand" MouseRightButtonUp="RunsLabel_RightClick"/>
      </StackPanel>
    </Border>

    <!-- ═══ STATUS BAR ═══ -->
    <Border Grid.Row="3" Background="{StaticResource CrustBrush}"
            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid>
        <TextBlock x:Name="StatusLabel" Text="Ready"
                   Foreground="{StaticResource Subtext0Brush}" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock x:Name="HotkeyHint" HorizontalAlignment="Right"
                   Text="Rec: Ctrl+R  |  Play: F5  |  Stop All: End  |  Chain: F8"
                   Foreground="{StaticResource Overlay0Brush}"
                   FontSize="10" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Toast overlay -->
    <Border x:Name="ToastBorder" Grid.Row="1"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource BaseBrush}"
            BorderBrush="{StaticResource BlueBrush}" BorderThickness="2"
            CornerRadius="12" Padding="24,16"
            Visibility="Collapsed" Panel.ZIndex="100">
      <TextBlock x:Name="ToastText" FontSize="14" FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}"
                 TextAlignment="Center" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
