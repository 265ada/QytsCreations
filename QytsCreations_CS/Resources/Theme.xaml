<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Catppuccin Mocha palette -->
  <Color x:Key="Base">#1e1e2e</Color>
  <Color x:Key="Mantle">#181825</Color>
  <Color x:Key="Crust">#11111b</Color>
  <Color x:Key="Surface0">#313244</Color>
  <Color x:Key="Surface1">#45475a</Color>
  <Color x:Key="Overlay0">#6c7086</Color>
  <Color x:Key="Text">#cdd6f4</Color>
  <Color x:Key="Subtext0">#a6adc8</Color>
  <Color x:Key="Blue">#89b4fa</Color>
  <Color x:Key="Green">#a6e3a1</Color>
  <Color x:Key="Red">#f38ba8</Color>
  <Color x:Key="Yellow">#f9e2af</Color>
  <Color x:Key="Peach">#fab387</Color>
  <Color x:Key="Mauve">#cba6f7</Color>
  <Color x:Key="Teal">#94e2d5</Color>

  <SolidColorBrush x:Key="BaseBrush"     Color="{StaticResource Base}"/>
  <SolidColorBrush x:Key="MantleBrush"   Color="{StaticResource Mantle}"/>
  <SolidColorBrush x:Key="CrustBrush"    Color="{StaticResource Crust}"/>
  <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
  <SolidColorBrush x:Key="TextBrush"     Color="{StaticResource Text}"/>
  <SolidColorBrush x:Key="Subtext0Brush" Color="{StaticResource Subtext0}"/>
  <SolidColorBrush x:Key="BlueBrush"     Color="{StaticResource Blue}"/>
  <SolidColorBrush x:Key="GreenBrush"    Color="{StaticResource Green}"/>
  <SolidColorBrush x:Key="RedBrush"      Color="{StaticResource Red}"/>
  <SolidColorBrush x:Key="YellowBrush"   Color="{StaticResource Yellow}"/>
  <SolidColorBrush x:Key="MauveBrush"    Color="{StaticResource Mauve}"/>
  <SolidColorBrush x:Key="Overlay0Brush" Color="{StaticResource Overlay0}"/>
  <SolidColorBrush x:Key="PeachBrush"    Color="{StaticResource Peach}"/>
  <SolidColorBrush x:Key="TealBrush"     Color="{StaticResource Teal}"/>

  <!-- Button base -->
  <Style TargetType="Button">
    <Setter Property="Background"   Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush"  Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"      Value="10,5"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="FontFamily"   Value="Segoe UI"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox -->
  <Style TargetType="TextBox">
    <Setter Property="Background"    Value="{StaticResource MantleBrush}"/>
    <Setter Property="Foreground"    Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush"   Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"       Value="6,4"/>
    <Setter Property="CaretBrush"    Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily"    Value="Consolas"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox -->
  <Style TargetType="ComboBox">
    <Setter Property="Background"   Value="{StaticResource MantleBrush}"/>
    <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush"  Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Padding"      Value="6,4"/>
  </Style>

  <!-- Label / TextBlock -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>

  <!-- CheckBox -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>

  <!-- TabControl -->
  <Style TargetType="TabControl">
    <Setter Property="Background"  Value="{StaticResource BaseBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
    <Setter Property="Padding"    Value="12,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1,1,1,0"
                  CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="2,2,2,0">
            <ContentPresenter ContentSource="Header"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BaseBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ListBox -->
  <Style TargetType="ListBox">
    <Setter Property="Background"  Value="{StaticResource MantleBrush}"/>
    <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding"    Value="8,4"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- DataGrid -->
  <Style TargetType="DataGrid">
    <Setter Property="Background"          Value="{StaticResource MantleBrush}"/>
    <Setter Property="Foreground"          Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush"         Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness"     Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="RowBackground"       Value="{StaticResource MantleBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource BaseBrush}"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows"      Value="False"/>
    <Setter Property="SelectionMode"       Value="Single"/>
    <Setter Property="FontFamily"          Value="Consolas"/>
    <Setter Property="FontSize"            Value="12"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding"    Value="8,4"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="DataGridRow">
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="4,2"/>
  </Style>

  <!-- ScrollBar -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
  </Style>

  <!-- ═══ POP BUTTONS: Record / Play / Stop / Chain ═══ -->
  <Style x:Key="BtnRecord" TargetType="Button">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0"   Color="#ff5a8a"/>
          <GradientStop Offset="0.5" Color="#ff3060"/>
          <GradientStop Offset="1"   Color="#b81a45"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderBrush" Value="#ff85b0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="#ff3060" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="#ffc0d8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPlay" TargetType="Button">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0"   Color="#ffd744"/>
          <GradientStop Offset="0.5" Color="#f0b820"/>
          <GradientStop Offset="1"   Color="#b07000"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="#1e1e2e"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderBrush" Value="#ffe070"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="#f0b820" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="#fff0a0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnStop" TargetType="Button">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0"   Color="#ff5050"/>
          <GradientStop Offset="0.5" Color="#e02020"/>
          <GradientStop Offset="1"   Color="#a00000"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderBrush" Value="#ff8080"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="#e02020" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="#ffb0b0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChainPlayButton" TargetType="Button">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#f9e2af"/>
          <GradientStop Offset="1" Color="#fab387"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="#1e1e2e"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.92"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#5a2536"/>
    <Setter Property="Foreground" Value="#f5b3c5"/>
    <Setter Property="BorderBrush" Value="#f38ba8"/>
  </Style>

</ResourceDictionary>
