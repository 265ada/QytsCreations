<UserControl x:Class="QytCroRec.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface0Brush}" Padding="14,10">
      <StackPanel>
        <TextBlock Text="⌨ Keyboard Shortcuts" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Click a key field, then press the combo you want. ESC cancels."
                   Foreground="{StaticResource Subtext0Brush}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ShortcutList" Margin="14">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBox Grid.Column="1" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Tag="{Binding Action}"
                       PreviewKeyDown="ShortcutBox_KeyDown"
                       GotFocus="ShortcutBox_GotFocus"
                       FontFamily="Consolas"
                       Background="{StaticResource MantleBrush}"
                       Foreground="{StaticResource TextBrush}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CrustBrush}"
            BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0"
            Padding="14,8">
      <StackPanel Orientation="Horizontal">
        <Button Content="Reset All to Defaults" Padding="14,6" Click="BtnReset_Click"/>
        <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="14,0,0,0"
                   Foreground="{StaticResource Subtext0Brush}"
                   Text="Changes save automatically. Re-registers global hotkeys on save."/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
