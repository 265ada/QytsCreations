<Window x:Class="QytCroRec.Dialogs.DragPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drag to pick" Height="160" Width="420"
        Background="{StaticResource BaseBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Topmost="True">
  <Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
      <TextBlock Text="🎯 Click and drag to pick a window"
                 FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource BlueBrush}"
                 HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock x:Name="HoverInfo" Text="(hover over target then release)"
                 FontFamily="Consolas" FontSize="11"
                 Foreground="{StaticResource Subtext0Brush}"
                 TextWrapping="Wrap" TextAlignment="Center"/>
      <Button x:Name="BtnPick" Content="Hold here &amp; drag to target"
              Width="220" Height="34" Margin="0,12,0,0"
              PreviewMouseLeftButtonDown="BtnPick_Down"
              PreviewMouseMove="BtnPick_Move"
              PreviewMouseLeftButtonUp="BtnPick_Up"/>
    </StackPanel>
  </Grid>
</Window>
