<Window x:Class="QytCroRec.Dialogs.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Viewer" Height="500" Width="800"
        Background="{StaticResource BaseBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="0,0,0,8"
               FontSize="14" FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"/>

    <TextBox x:Name="LogBox" Grid.Row="1"
             IsReadOnly="True"
             FontFamily="Consolas" FontSize="11"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             Background="{StaticResource CrustBrush}"
             Foreground="{StaticResource TextBrush}"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Refresh" Width="80" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
      <Button Content="Open Folder" Width="100" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
      <Button Content="Clear" Width="80" Margin="0,0,8,0" Click="BtnClear_Click"/>
      <Button Content="Copy All" Width="80" Margin="0,0,8,0" Click="BtnCopy_Click"/>
      <Button Content="Close" Width="80" Click="BtnClose_Click"/>
    </StackPanel>
  </Grid>
</Window>
