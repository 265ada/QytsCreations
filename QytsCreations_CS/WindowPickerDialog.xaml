<Window x:Class="QytCroRec.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Target Window" Height="460" Width="620"
        Background="{StaticResource BaseBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Select the window to target (double-click or OK):"
               Margin="0,0,0,8" Foreground="{StaticResource Subtext0Brush}"/>

    <DataGrid x:Name="WindowGrid" Grid.Row="1"
              AutoGenerateColumns="False" CanUserAddRows="False"
              SelectionMode="Single" IsReadOnly="True"
              MouseDoubleClick="WindowGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Title"   Binding="{Binding Title}"   Width="*"/>
        <DataGridTextColumn Header="PID"     Binding="{Binding Pid}"     Width="70"/>
        <DataGridTextColumn Header="HWND"    Binding="{Binding HwndHex}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Refresh" Width="80" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
      <Button Content="OK"     Width="80" Margin="0,0,8,0" Click="BtnOk_Click"/>
      <Button Content="Cancel" Width="80" Click="BtnCancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
